+/**
+ * Find the one persona text scalar without normalizing the surrounding YAML.
+ * Group rows recurse through their entry lists because a valid preset may put
+ * the persona inside an isolated realm.
+ */
+function personaTextNode(content: string, presetId: string): Scalar<string> {
+  const document = parseDocument(content, { prettyErrors: false, uniqueKeys: true })
+  if (document.errors.length > 0) {
+    throw new PresetPersonaError(
+      presetId,
+      `the composition is invalid YAML (${document.errors.map(error => error.code).join(', ')})`,
+    )
+  }
+
+  const found: Scalar<string>[] = []
+  const visit = (rows: unknown): void => {
+    if (!isSeq(rows)) return
+    for (const row of rows.items) {
+      if (!isMap(row)) continue
+      if (row.get('name') === PERSONA_PLUGIN) {
+        const config = row.get('config', true)
+        const text = isMap(config) ? config.get('text', true) : undefined
+        if (!isScalar(text) || typeof text.value !== 'string' || text.range === undefined) {
+          throw new PresetPersonaError(
+            presetId,
+            `the ${PERSONA_PLUGIN} row must carry a string config.text`,
+          )
+        }
+        found.push(text as Scalar<string>)
+      }
+      if (row.get('group') === true) visit(row.get('config', true))
