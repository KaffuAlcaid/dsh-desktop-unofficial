+/** Canonical effort ids accepted by the pi-ai model schema. */
+const REASONING_LEVELS = ['off', 'minimal', 'low', 'medium', 'high', 'xhigh', 'max'] as const
+
+/** A localized reasoning-map failure for one model row. */
+export interface ModelReasoningValidationFailure {
+  /** Zero-based model position. */
+  index: number
+  /** Message key owned by the Models settings section. */
+  key: 'modelReasoningInvalid'
+}
+
+/** Validate the llm-pi-ai constraints that the editable mapping must satisfy. */
+export function validateModelReasoning(value: unknown): ModelReasoningValidationFailure | undefined {
+  if (!Array.isArray(value)) return undefined
+  const known = new Set<string>(REASONING_LEVELS)
+  for (const [index, entry] of value.entries()) {
+    if (typeof entry !== 'object' || entry === null || Array.isArray(entry)) continue
+    const efforts = (entry as Record<string, unknown>)['reasoningEfforts']
+    if (efforts === undefined || efforts === false) continue
+    if (typeof efforts !== 'object' || efforts === null || Array.isArray(efforts)) {
+      return { index, key: 'modelReasoningInvalid' }
+    }
+    const rows = Object.entries(efforts)
+    let hasThinkingLevel = false
+    for (const [level, wire] of rows) {
+      if (!known.has(level)) return { index, key: 'modelReasoningInvalid' }
+      if (level === 'off' && wire === null) continue
+      if (level !== 'off') hasThinkingLevel = true
+      if (typeof wire !== 'string' || wire.length === 0) return { index, key: 'modelReasoningInvalid' }
+    }
+    if (!hasThinkingLevel) return { index, key: 'modelReasoningInvalid' }
+  }
+  return undefined
+}
