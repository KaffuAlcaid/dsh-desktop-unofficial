{
  "name": "dsh-desktop-unofficial",
  "version": "0.1.0",
  "description": "Unofficial desktop distribution for DeepSeek Harness",
  "private": true,
  "type": "module",
  "main": "dist/main.js",
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "pnpm run build && electron .",
    "prepare:harness": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/prepare-harness.ps1",
    "prepare:harness:linux": "bash scripts/prepare-harness.sh",
    "package:portable:win": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/package-portable.ps1",
    "package:installer:win": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/package-portable.ps1 -Target nsis",
    "package:portable:linux": "bash scripts/package-portable.sh",
    "start": "electron ."
  },
  "devDependencies": {
    "@types/node": "22.20.0",
    "electron": "43.4.0",
    "electron-builder": "26.15.3",
    "typescript": "6.0.3"
  }
}
